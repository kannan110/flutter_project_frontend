<?xml version="1.0" encoding="utf-8"?>
<!--
  styles.xml
  ──────────────────────────────────────────────────────────────────────────────
  LaunchTheme   → applied to MainActivity on cold start.
                  windowBackground = transparent so nothing shows before Flutter.
                  windowIsTranslucent = false keeps GPU composition normal.

  NormalTheme   → swapped in by Flutter engine after first frame is drawn.
                  windowBackground = black avoids any flicker during the swap.

  The key fix is windowBackground = @drawable/launch_background which is
  now fully transparent (no white, no icon). Flutter's own Dart splash
  (SplashScreen widget) is the only thing the user ever sees.
-->
<resources>

    <!-- ── Launch theme: shown while Flutter engine initialises ── -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Transparent window = native layer is invisible before Flutter renders -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Keep status bar space consistent -->
        <item name="android:windowFullscreen">false</item>
        <!-- Prevent the brief white flash from window compositor -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- ── Normal theme: applied after Flutter first frame ──────── -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">false</item>
    </style>

</resources>
